.env
*.env
.env.*
!.env.example
!*.env.example
backend/.env
frontend/.env
frontend/.env.local

# ==============================================================================
# Local Database Files & Logs
# ==============================================================================
*.db
*.sqlite
*.sqlite3
incident_db.db
backend/incident_db.db
*.log

