# ==============================================================================
# backend/.env.example (TEMPLATE - SAFE FOR VERSION CONTROL)
# ==============================================================================
APP_ENV=development
API_PORT=8000
DEBUG=true

# Database Configuration
# Default is async SQLite for instant local zero-dependency development.
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/incident_db
DATABASE_URL=sqlite+aiosqlite:///./incident_db.db

# Security & Authentication
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Google Gemini API
GEMINI_API_KEY=PASTE_MY_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Operational Settings
AUTO_REMEDIATION_ENABLED=true
SIMULATION_MODE=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

